# OpsMind Helpdesk Environment Configuration Example

# Demo mode: set to "true" for local demo with pre-seeded demo accounts (user/agent/admin).
# In production/deployment, set to "false" (default) or leave empty.
DEMO_MODE=false

# Required in production when DEMO_MODE=false
SECRET_KEY=change-this-to-a-secure-random-secret-key-at-least-32-chars

# Token lifetime in minutes
TOKEN_EXPIRE_MINUTES=60

# Initial admin provisioning (required on first non-demo startup)
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=SetYourVerySecurePasswordHere123!

# Public URL of the application (required in production for password reset links)
PUBLIC_BASE_URL=https://helpdesk.yourdomain.com

# Database configuration:
# - Để trống để sử dụng SQLite cục bộ (data/helpdesk.sqlite3)
# - Hoặc điền chuỗi kết nối PostgreSQL / Neon Serverless Postgres (khuyên dùng Pooled connection -pooler):
# DATABASE_URL=postgresql://neondb_owner:npg_xxxx@ep-cool-forest-123456-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
HELPDESK_DB_PATH=data/helpdesk.sqlite3
HELPDESK_STORAGE_PATH=data

# Optional LLM RAG settings
ENABLE_LLM_GENERATION=false
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=5.0

# SMTP Email settings for Password Reset (Layer 2)
# Khi bật SMTP_ENABLED=true với Gmail, hãy sử dụng App Password (Mật khẩu ứng dụng 16 ký tự)
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@opsmind.internal
SMTP_USE_TLS=true
RESET_TOKEN_EXPIRE_MINUTES=15

# Notification Webhooks (Telegram & Discord)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
DISCORD_WEBHOOK_URL=

